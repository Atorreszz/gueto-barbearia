# ===================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ===================================================================
# Para usar: copie este arquivo, renomeie a cópia para .env e preencha os valores.
# O arquivo .env NUNCA é enviado para o GitHub (está no .gitignore).
#
# No .NET, chaves aninhadas usam duplo sublinhado (__) como separador:
# ===================================================================

# Banco de Dados PostgreSQL
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=gueto_barbearia;Username=postgres;Password=SUA_SENHA_AQUI

# Configuração de Autenticação JWT (mínimo de 32 caracteres / 256 bits para segurança)
JWT__KEY=SUA_CHAVE_SECRETA_JWT_COM_PELO_MENOS_32_CARACTERES_AQUI
JWT__ISSUER=GuetoBarbearia.com.br
JWT__AUDIENCE=GuetoBarbearia.com.br
